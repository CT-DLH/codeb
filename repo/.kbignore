# .kbignore — 哪些源码算「被索引的对象」
#
# gitignore 语法：路径模式，/ 结尾表示目录，! 开头表示反向豁免（重新纳入），
# 后面的规则覆盖前面的规则。所有路径相对知识库根（codeb/）。
#
# 与 Markdown 页表的分工：
#   .kbignore  机器解析的选型规则（什么算源码、什么算噪音）
#   *.md       人读的叙述（职责、场景、部件表）
# 不要把规则写进 md：程序不会去读散文，写在那里等于没有。

# ══ 全局噪音：任何仓库都不索引 ══
node_modules/
.git/
dist/
build/
out/
.venv/
venv/
agvenv/
site-packages/
__pycache__/
.pytest_cache/
.ruff_cache/
.next/
.turbo/
coverage/
*.lock
package-lock.json
pnpm-lock.yaml
yarn.lock
tsconfig.tsbuildinfo

# 知识库自身的工作目录（不是源码）
_kbwork/
repo/
webview/

# ══ infohub ══
# 第三方 vendored 参考代码：1856 个文件，不是本项目在维护的东西
infohub/参考项目/
# 构建产物
infohub/.svelte-kit/
# 一次性探针脚本（67 个 survey-*-probe.py），跑完就没用了
infohub/.cache/
infohub/.scratch/
# 一次性运维脚本：不进页表，避免把噪音当模块
infohub/scripts/

# infohub 真正在维护的代码（反向豁免，防止被上面过宽的规则误伤）
!infohub/collector/
!infohub/src/
!infohub/console/
!infohub/inbox/

# collector/tools/ 是一次性 CLI 入口的集散地，72 个文件里混着两类东西。
# 判定依据（实测，不是猜）：这 72 个模块**没有任何一个**被其它代码 import，
# 全部靠 `python -m collector.tools.xxx` 手动执行。
#   正式入口  run_* / crawl_* / collect_* / site_*     → 纳入索引
#   一次性    backfill_* / fix_* / migrate_* / probe_* → 排除
infohub/collector/tools/backfill_*
infohub/collector/tools/fix_*
infohub/collector/tools/migrate_*
infohub/collector/tools/probe_*
infohub/collector/tools/_dump_*
infohub/collector/tools/dump_*
infohub/collector/tools/selftest.py
infohub/collector/tools/measure_grammar.py

# ══ atomkgraph ══
atomkgraph/node_modules/
atomkgraph/.turbo/
atomkgraph/.vite/
# 一次性探针 / E2E 脚本，不是产品代码
atomkgraph/.cache/
atomkgraph/.scratch/
atomkgraph/.tmp_*
atomkgraph/dist/
atomkgraph/packages/*/dist/

# ══ codeb ══
codeb/_kbwork/
codeb/distill/agent/agvenv/
